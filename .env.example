# Copie para .env e preencha com seus valores reais.
# NUNCA faça commit do arquivo .env.

# Chave de sessão do Flask (use um valor aleatório e longo em produção)
SECRET_KEY=troque_por_uma_chave_aleatoria

# Chave da Groq API (https://console.groq.com/keys)
GROQ_API_KEY=coloque_sua_chave_groq_aqui

# (Opcional) Modelo padrão da Groq
GROQ_MODEL=llama-3.3-70b-versatile
